# Optional env for docker compose -f deploy/docker-compose.workbuddy.yml
WB_ALLOW_OUTBOUND=0
WB_LLM_BASE_URL=http://host.docker.internal:11434/v1
WB_LLM_MODEL=qwen2.5:3b

# Multi-tenant production (required for --profile prod)
# WB_MULTI_TENANT=1
# WB_CONSOLE_AUTH=1
# WB_CONSOLE_SECRET=replace-with-openssl-rand-hex-32
# WB_ARTIFACTS_ROOT=/app/artifacts
# WB_DOMAIN=localhost
# （域名可选，不是交付门槛；需要公网主机名时再改 WB_DOMAIN）

# OCTOP_CASDOOR_ENDPOINT=http://host.docker.internal:8001
# OCTOP_CASDOOR_CLIENT_ID=wb-local
# OCTOP_CASDOOR_CLIENT_SECRET=wb-local-secret
# OCTOP_MILVUS_URI=http://host.docker.internal:9091
# （compose: --profile casdoor --profile milvus up -d）
