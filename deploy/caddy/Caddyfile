{$WB_DOMAIN:localhost} {
	# Local / private deployments: use internal CA (no public DNS required).
	# For public domains, remove `tls internal` and let Caddy obtain a public cert.
	tls internal

	encode gzip
	reverse_proxy wb-console-prod:8010

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
	}
}
