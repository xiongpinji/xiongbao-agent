# Local / private: Caddy internal CA (browser will warn until trusted).
# Prefer https://localhost/ — https://127.0.0.1/ also works after this reload.
# Plain HTTP fallback for实测: http://127.0.0.1:8010/ (console port published in compose).

localhost, 127.0.0.1 {
	tls internal

	encode gzip
	reverse_proxy wb-console-prod:8010

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
	}
}
